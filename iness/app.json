{
  "expo": {
    "name": "iness",
    "slug": "iness",
    "jsEngine": "hermes",
    "version": "1.0.49",
    "orientation": "default",
    "notification": {
      "icon": "./assets/images/logonew.png",
      "color": "#FF231F7C"
    },
    "icon": "./assets/images/androidlogo.png",
    "scheme": "myapp",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "icon": "./assets/images/logonew.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.iness.fitness",
      "buildNumber": "62",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "We use the microphone for video recording.",
        "NSCameraUsageDescription": "We use the camera to allow users to take profile photos."
      }
    },
    "android": {
      "icon": "./assets/images/androidlogo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/androidlogo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 35,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": { "scheme": "myapp" },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "useNextNotificationsApi": true,
      "package": "com.iness.fitness",
      "privacy": "https://iness.fitness/policy"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logonew.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logonew.png",
          "imageWidth": 200
        }
      ],
      "expo-video",
      "expo-notifications",
      "react-native-edge-to-edge",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26,
            "ndk": "27.1.12297006"
          }
        }
      ],
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": true,
          "healthSharePermission": "We need access to your health data to sync your steps and sleep information.",
          "healthUpdatePermission": "We need access to update your health data with tracking information."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": { "origin": false },
      "eas": {
        "projectId": "87dfba75-ecf1-4c1c-9b9a-74df81667288"
      }
    },
    "owner": "sounick_project"
  }
}
