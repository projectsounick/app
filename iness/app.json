{
  "expo": {
    "name": "iness",
    "slug": "iness",
    "jsEngine": "hermes",
    "version": "1.0.24",
    "orientation": "default",
    "notification": {
      "icon": "./assets/images/logonew.png",
      "color": "#FF231F7C"
    },
    "icon": "./assets/images/androidlogo.png",
    "scheme": "myapp",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "icon": "./assets/images/logonew.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.iness.fitness",
      "buildNumber": "1.0.24",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "We use the microphone for video recording.",
        "NSCameraUsageDescription": "We use the camera to allow users to take profile photos."
      }
    },
    "android": {
      "icon": "./assets/images/androidlogo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/androidlogo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 23,
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": ["NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": { "scheme": "myapp" },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "useNextNotificationsApi": true,

      "package": "com.iness.fitness"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logonew.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logonew.png",
          "imageWidth": 200
        }
      ],

      "expo-video",
      "expo-notifications",

      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26,
            "ndk": "26.1.10909125"
          }
        }
      ],
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": true,
          "healthSharePermission": "Custom health share permission",
          "healthUpdatePermission": "Custom health update permission",
          "healthClinicalDescription": "Custom health share permission for clinical data"
        }
      ],
      "./plugins/with-phonepe"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": { "origin": false },
      "eas": {
        "projectId": "d80cbfa4-17b7-44ae-9955-a47743e5be15"
      }
    },
    "owner": "surjayan"
  }
}
