{
  "expo": {
    "name": "iness",
    "slug": "iness",
    "version": "1.0.23",
    "orientation": "portrait",
    "icon": "./assets/images/logonew.png",
    "scheme": "myapp",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.iness.fitness",
      "buildNumber": "1.0.23",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "We use the microphone for video recording.",
        "NSCameraUsageDescription": "We use the camera to allow users to take profile photos."
      }
    },
    "android": {
      "versionCode": 20,
      "minSdkVersion": 26,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": ["NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "myapp"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "useNextNotificationsApi": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logonew.png",
        "backgroundColor": "#000000"
      },
      "package": "com.iness.fitness"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logonew.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logonew.png",
          "imageWidth": 200
        }
      ],
      "expo-video",
      "expo-notifications",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "experimental": {
      "exportEmbed": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "87dfba75-ecf1-4c1c-9b9a-74df81667288"
      }
    },
    "owner": "sounick_project"
  }
}
